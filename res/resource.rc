#include <windows.h>
#include <commctrl.h>
#include "resource.h"

// Application Manifest
1 RT_MANIFEST "app.manifest"

// Application Icons (Derived from monitor.svg)
IDI_APP_ICON ICON "app.ico"
IDI_ICON_DARK_TASKBAR ICON "icon_dark_taskbar.ico"
IDI_ICON_LIGHT_TASKBAR ICON "icon_light_taskbar.ico"

// Hotkey Configuration Dialog
IDD_HOTKEY_DIALOG DIALOGEX 0, 0, 216, 110
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Configure Hotkey"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Modifiers", IDC_STATIC, 7, 7, 202, 28
    CONTROL         "Win", IDC_CHK_WIN, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 18, 38, 11
    CONTROL         "Alt", IDC_CHK_ALT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 62, 18, 36, 11
    CONTROL         "Ctrl", IDC_CHK_CTRL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 108, 18, 38, 11
    CONTROL         "Shift", IDC_CHK_SHIFT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 155, 18, 44, 11

    LTEXT           "Key:", IDC_STATIC, 10, 44, 24, 11
    COMBOBOX        IDC_COMBO_KEY, 38, 42, 168, 140, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Preview:", IDC_STATIC_PREVIEW, 10, 62, 196, 12

    PUSHBUTTON      "Disable Hotkey", IDC_BTN_DISABLE, 7, 85, 66, 15
    DEFPUSHBUTTON   "OK", IDOK, 105, 85, 48, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 158, 85, 48, 15
END
